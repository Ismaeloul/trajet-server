# Copia este fichero como .env (NUNCA se sube a git) y rellena lo que haga
# falta. Lo leen `docker compose up` (desarrollo en este PC) y
# scripts/test-real.sh. Todo es opcional: sin nada, el servidor arranca, el
# panel funciona y la clave de PRIM se pega en el panel.
#
# En el Umbrel NO se usa este fichero: la app de la tienda pone sus propias
# variables (ver README, «Variables de entorno»).

# Clave de PRIM. Opcional desde la 0.4.0: la que guardes en el panel manda y
# esta queda solo como alternativa. scripts/test-real.sh la necesita.
PRIM_API_KEY=

# Semilla para cifrar la clave de PRIM que se guarda en el panel (en el Umbrel
# es ${APP_SEED}). Una cadena larga y aleatoria, por ejemplo la salida de:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la cambias, la clave guardada ya no se puede descifrar: hay que volver a
# pegarla en el panel. Sin semilla se crea data/secrets/master.key.
TRAJET_SECRET_SEED=

# Direcciones que van en el QR de emparejamiento (valor inicial: lo que se
# guarde en el panel manda). Forma: http://<IP o nombre>:7796, sin barra al
# final. Para probar con el iPhone contra este PC tendrias que publicar el
# puerto fuera de 127.0.0.1, y el compose de desarrollo no lo hace a proposito.
TRAJET_LAN_URL=
TRAJET_TAILSCALE_URL=
TRAJET_SERVER_NAME=Trajet

# Traduccion de los avisos con Ollama. Vacio = sin traduccion (los avisos
# salen en frances y todo lo demas funciona igual).
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# Recolector de andenes y mapa con datos abiertos de IDFM (1 = encendido).
TRAJET_COLLECT=1
TRAJET_MAP=1

TRAJET_LOG_LEVEL=INFO
